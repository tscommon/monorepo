{
  "name": "@tscommon/monorepo",
  "description": "A set of common TypeScript constructs",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "format": "prettier . --check",
    "lint": "eslint",
    "test": "vitest --run",
    "bench": "vitest bench --run",
    "docs": "typedoc",
    "test:coverage": "vitest --run --coverage",
    "ci:publish": "pnpm publish -r --access public && changeset tag",
    "ci:version": "pnpm changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@codspeed/vitest-plugin": "4.0.1",
    "@eslint/js": "9.35.0",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.6.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "rollup": "4.50.1",
    "ts-node": "10.9.2",
    "tsd": "0.33.0",
    "tslib": "2.8.1",
    "typedoc": "0.28.13",
    "typedoc-theme-oxide": "0.2.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vitest": "3.2.4"
  }
}
