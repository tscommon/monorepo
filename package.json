{
  "name": "@tscommon/monorepo",
  "description": "A set of common TypeScript constructs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "scripts": {
    "format": "prettier . --check",
    "lint": "eslint",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "ci:publish": "pnpm publish -r --access public && changeset tag",
    "ci:version": "pnpm changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@eslint/js": "9.35.0",
    "@vitest/coverage-v8": "3.2.4",
    "docusaurus-plugin-typedoc-api": "4.4.0",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsd": "0.33.0",
    "typedoc": "0.28.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vitest": "3.2.4"
  }
}
